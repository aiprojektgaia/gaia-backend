# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=
POSTGRES_PORT=
POSTGRES_DB=

# Application
MODEL_BASE_PATH=
STORAGE_PATH=
DEBUG=false

# A processing step (tiling, segmentation, vectorisation...) running longer
# than this is killed and the run fails. Large areas take a while; keep this
# above your longest normal step. The tiler itself stops after 4 hours.
TASK_STEP_TIMEOUT_SECONDS=3600

# API authentication - REQUIRED, no default.
# Every request must send this value in the X-API-Key header. The backend will
# refuse to start if this is empty. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter the same value in the QGIS plugin under Installningar -> API key.
GAIA_API_KEY=

# Comma-separated browser origins allowed to call this API. Leave empty unless
# you run a browser-based client; the QGIS plugin does not need it.
# Never set this to "*".
CORS_ALLOW_ORIGINS=

# WMS servers projects may use, comma-separated origins (scheme://host:port).
# Checked by the backend and by the engine's tiler. Use the address the
# *backend container* reaches GeoServer on, e.g. http://geoserver:8080.
GAIA_WMS_ALLOWED_ORIGINS=http://geoserver:8080
