# HTTPS proxy in front of the GAIA API (Caddy). Copy to proxy.env.

# The host name or IP address QGIS users type in the plugin, e.g.
# gaia.kommun.se or 10.20.30.40. The certificate is issued for this name, so it
# must match exactly what users connect to. Behind another reverse proxy, use
# the public name that proxy serves (e.g. gaia.example.se); the proxy should send
# that name as SNI, or no SNI at all, when it connects to port 8443.
GAIA_SERVER_NAME=

# Which certificate to serve:
#   internal  - Caddy creates its own certificate authority and issues the
#               certificate itself. Workstations must trust Caddy's root
#               certificate once (see docs/INSTALLATION.md).
#   /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem
#             - a certificate from your organisation's CA. Put the files in
#               docker/certs/ (mounted read-only into the proxy).
GAIA_TLS=internal
