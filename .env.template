# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SERVER=
POSTGRES_PORT=
POSTGRES_DB=

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=300
DB_POOL_RECYCLE=3600

# Application
MODEL_BASE_PATH=
STORAGE_PATH=
DEBUG=false

TASK_STEP_TIMEOUT_SECONDS=60

# Default interface names
DEFAULT_IMAGE_TILER_INTERFACE_NAME="wms_tiler"
DEFAULT_IMAGE_TO_BIT_INTERFACE_NAME="image_bitter"
DEFAULT_VECTORIZE_INTERFACE_NAME="vector_hector"

# API authentication - REQUIRED, no default.
# Every request must send this value in the X-API-Key header. The backend will
# refuse to start if this is empty. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Enter the same value in the QGIS plugin under Installningar -> API key.
GAIA_API_KEY=

# Comma-separated browser origins allowed to call this API. Leave empty unless
# you run a browser-based client; the QGIS plugin does not need it.
# Never set this to "*".
CORS_ALLOW_ORIGINS=
